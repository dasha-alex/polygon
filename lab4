#pragma once
#include <iostream>
#include <vector>
#include <chrono>
using namespace std;

void splitTwoGroups(vector<double>& array,
	int index,
	vector<double>& g1,
	vector<double>& g2,
	pair<vector<double>, vector<double>>& res,
	int j,
	int& k) {

	if (k == j) {
		return;
	}

	if (index == array.size()) {
		k++;
		res = make_pair(g1, g2);
		return;
	}

	g1.push_back(array[index]);
	splitTwoGroups(array, index + 1, g1, g2, res, j, k);
	g1.pop_back();

	g2.push_back(array[index]);
	splitTwoGroups(array, index + 1, g1, g2, res, j, k);
	g2.pop_back();
}


double clusterVariance(vector<double>& cluster) {
	if (cluster.size() <= 1) return 0;

	double mean = 0;

	for (double elem : cluster) {
		mean += elem;
	}

	mean /= cluster.size();
	double vairance = 0;

	for (double elem : cluster) {
		vairance += abs(elem - mean);
	}

	return vairance;
}

pair<vector<double>, vector<double>> bestTwoPartition(vector<double>& array) {
	if (array.size() <= 1) {
		return make_pair(array, vector<double>());
	}
	double bestQuality = numeric_limits<double>::infinity();
	double quality = 0;

	vector<double> g1, g2;
	pair<vector<double>, vector<double>> res;

	pair<vector<double>, vector<double>> bestTwoClusters;

	for (int i = 1; i < pow(2, array.size()) - 1; i++)
	{
		int k = 0;
		splitTwoGroups(array, 0, g1, g2, res, i, k);

		quality = clusterVariance(res.first) + clusterVariance(res.second);

		if (quality < bestQuality) {
			bestQuality = quality;
			bestTwoClusters = res;
		}

	}

	return bestTwoClusters;
}

void main() {
	setlocale(LC_ALL, "RU");
	auto start = std::chrono::high_resolution_clock::now();
	vector<double> arr(2);

	for (int i = 0; i < arr.size(); i++) {
		arr[i] = rand() % 1001 - 500;
	}

	auto res = bestTwoPartition(arr);
	cout << "Первый кластер: { ";
	for (double n : res.first) {
		cout << n << " ";
	}
	cout << "}" << endl;

	cout << "Второй кластер: { ";
	for (double n : res.second) {
		cout << n << " ";
	}
	cout << "}" << endl;

	auto end = std::chrono::high_resolution_clock::now();
	auto duration = std::chrono::duration_cast<std::chrono::seconds>(end - start);


	std::cout << "Время выполнения: " << duration.count() / 60 << " минут " << duration.count() % 60 << " секунд" << std::endl;

}
