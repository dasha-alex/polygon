#include <iostream>
#include <vector>
#include <chrono>
#include "Header.h"

using namespace std;

void bublesort(vector<int>& a) { //O(n^2)
	int n = a.size();
	int t;
	for (int i = 0; i < n; i++) {
		for (int j = 0; j < n - i - 1; j++) {
			if (a[j] > a[j + 1]) {
				t = a[j];
				a[j] = a[j + 1];
				a[j + 1] = t;
			}
		}
	}
}

int partition(vector<int>& a, int l, int r)
{
	int piv = a[l];

	int left = l + 1;
	int right = r;
	while (true) {

		while (left <= right && a[left] <= piv) {
			left++;
		}

		while (left <= right && a[right] >= piv) {
			right--;
		}

		if (right < left) {
			break;
		}

		int temp = a[left];
		a[left] = a[right];
		a[right] = temp;
	}

	int temp = a[l];
	a[l] = a[right];
	a[right] = temp;

	return right;
}

void quicksort(vector<int>& a, int left, int right) { // O(n*log n)
	if (left < right) {
		int piv = partition(a, left, right);

		quicksort(a, left, piv);
		quicksort(a, piv + 1, right);

	}
}


void heapify(vector<int>& a, int n, int i) {
	int root = i;

	int l = 2 * i + 1;
	int r = 2 * i + 2;

	if (l < n && a[l] > a[root])
	{
		root = l;
	}

	if (r < n && a[r] > a[root])
	{
		root = r;
	}

	if (root != i) {
		int temp = a[i];
		a[i] = a[root];
		a[root] = temp;
		heapify(a, n, root);
	}

}

void heapSort(vector<int>& a) { //O(n+m)
	for (int i = a.size() / 2 - 1; i >= 0; i--) {
		heapify(a, a.size(), i);
	}

	for (int i = a.size() - 1; i >= 0; i--) {
		int temp = a[0];
		a[0] = a[i];
		a[i] = temp;

		heapify(a, i, 0);
	}
}

void randVector(vector<int>& a) {
	for (int i = 0; i < a.size(); i++) {
		a[i] = rand();
	}
}

void printArray(vector<int>& a) {
	for (int i = 0; i < a.size(); i++) {
		cout << a[i] << " ";
	}

	cout << endl;
}


void main() {
	setlocale(LC_ALL, "RU");

	vector<int> a(5);
	vector<int> b(5);
	vector<int> c(5);
	randVector(a);
	randVector(b);
	randVector(c);

	cout << "a: ";
	printArray(a);
	cout << "b: ";
	printArray(b);
	cout << "c: ";
	printArray(c);

	cout << endl;
	cout << endl;

	auto start = chrono::high_resolution_clock::now();
	bublesort(a);
	auto end = chrono::high_resolution_clock::now();
	chrono::duration<double> elapsed_bubblesort = end - start;

	start = chrono::high_resolution_clock::now();
	quicksort(b, 0, b.size() - 1);
	end = chrono::high_resolution_clock::now();
	chrono::duration<double> elapsed_quicksort = end - start;

	start = chrono::high_resolution_clock::now();
	heapSort(c);
	end = chrono::high_resolution_clock::now();
	chrono::duration<double> elapsed_heapsort = end - start;

	cout << "a: ";
	printArray(a);
	cout << "b: ";
	printArray(b);
	cout << "c: ";
	printArray(c);

	cout << "Время выполнения пузырьковой сортировки: " << elapsed_bubblesort.count() << " секунд" << endl;
	cout << "Время выполнения быстрой сортировки: " << elapsed_quicksort.count() << " секунд" << endl;
	cout << "Время выполнения пирамидальной сортировки: " << elapsed_heapsort.count() << " секунд" << endl;

	cout << "a: ";
	printArray(a);
	cout << "b: ";
	printArray(b);
	cout << "c: ";
	printArray(c);
}
